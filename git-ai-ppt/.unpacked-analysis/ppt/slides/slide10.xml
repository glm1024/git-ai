                    <a:lstStyle/>
                    <a:p>
                      <a:pPr algn="l">
                        <a:lnSpc>
                          <a:spcPct val="108000"/>
                        </a:lnSpc>
                      </a:pPr>
                      <a:r>
                        <a:rPr lang="zh-CN" sz="1200" b="1" noProof="1">
                          <a:solidFill>
                            <a:srgbClr val="213261"/>
                          </a:solidFill>
                          <a:latin typeface="Microsoft YaHei"/>
                        </a:rPr>
                        <a:t>known_human 是怎么来的？</a:t>
                      </a:r>
                    </a:p>
                  </a:txBody>
                  <a:tcPr marT="27432" marB="27432" anchor="ctr">
                    <a:solidFill>
                      <a:srgbClr val="F7F9FB"/>
                    </a:solidFill>
                  </a:tcPr>
                </a:tc>
                <a:tc>
                  <a:txBody>
                    <a:bodyPr/>
                    <a:lstStyle/>
                    <a:p>
                      <a:pPr algn="l">
                        <a:lnSpc>
                          <a:spcPct val="108000"/>
                        </a:lnSpc>
                      </a:pPr>
                      <a:r>
                        <a:rPr lang="zh-CN" sz="1200" b="0" noProof="1">
                          <a:solidFill>
                            <a:srgbClr val="111111"/>
                          </a:solidFill>
                          <a:latin typeface="Microsoft YaHei"/>
                        </a:rPr>
                        <a:t>VS Code/Cursor 保存文档时，扩展收到 onDidSaveTextDocument 后打 known_human checkpoint；Auto Save、Save All、格式化保存也可能触发。</a:t>
                      </a:r>
                    </a:p>
                  </a:txBody>
